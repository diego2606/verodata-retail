# ─── Servidor ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Base de datos (PostgreSQL / Supabase) ────────────────────────────────────
DB_HOST=aws-0-us-east-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.<project-ref>
DB_PASSWORD=tu_password_de_supabase
DB_SSL=true

# ─── Autenticación ────────────────────────────────────────────────────────────
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=8h
JWT_REMEMBER_EXPIRES_IN=30d
BCRYPT_ROUNDS=10

# ─── CORS ─────────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── Google OAuth (opcional, para "Continuar con Google") ─────────────────────
# Credenciales del OAuth Client (Google Cloud Console > APIs y servicios).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Debe coincidir EXACTO con una "Authorized redirect URI" del cliente OAuth.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# ─── Mercado Libre API (opcional, para importar catálogo) ─────────────────────
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_ACCESS_TOKEN=

# ─── Supabase Storage (opcional, para alojar imágenes) ────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
